<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create an Account</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .card {
      background: #ffffff;
      width: 100%;
      max-width: 420px;
      padding: 32px;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    h2 {
      text-align: center;
      color: #1f2937;
      margin-bottom: 6px;
      font-size: 24px;
    }

    .subtitle {
      text-align: center;
      color: #6b7280;
      font-size: 14px;
      margin-bottom: 24px;
    }

    .form-group {
      margin-bottom: 16px;
      position: relative;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 6px;
    }

    input[type="text"],
    input[type="email"],
    input[type="password"] {
      width: 100%;
      padding: 11px 14px;
      border: 1.5px solid #d1d5db;
      border-radius: 8px;
      font-size: 15px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2);
    }

    input.error-border {
      border-color: #ef4444;
    }

    .password-wrapper {
      position: relative;
    }

    .toggle-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: #6b7280;
      font-size: 13px;
      cursor: pointer;
    }

    .error-msg {
      color: #ef4444;
      font-size: 12px;
      margin-top: 4px;
      display: none;
    }

    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #4b5563;
      margin-bottom: 20px;
    }

    .submit-btn {
      width: 100%;
      padding: 12px;
      background: #667eea;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }

    .submit-btn:hover {
      background: #5a67d8;
    }

    .status-banner {
      margin-top: 16px;
      padding: 12px;
      border-radius: 8px;
      font-size: 14px;
      text-align: center;
      display: none;
    }

    .status-banner.success {
      background: #d1fae5;
      color: #065f46;
      display: block;
    }
  </style>
</head>
<body>

  <div class="card">
    <h2>Create Account</h2>
    <p class="subtitle">Fill in your details to get started</p>

    <form id="registerForm" novalidate>
      <div class="form-group">
        <label for="fullName">Full Name</label>
        <input type="text" id="fullName" placeholder="Jane Doe" required />
        <div class="error-msg" id="nameError">Please enter your full name.</div>
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" placeholder="jane@example.com" required />
        <div class="error-msg" id="emailError">Please enter a valid email address.</div>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <div class="password-wrapper">
          <input type="password" id="password" placeholder="At least 8 characters" required />
          <button type="button" class="toggle-btn" id="togglePassword">Show</button>
        </div>
        <div class="error-msg" id="passwordError">Password must be at least 8 characters long.</div>
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input type="password" id="confirmPassword" placeholder="Re-enter password" required />
        <div class="error-msg" id="confirmError">Passwords do not match.</div>
      </div>

      <div class="checkbox-group">
        <input type="checkbox" id="terms" required />
        <label for="terms" style="margin: 0; font-weight: 400;">I agree to the Terms & Privacy Policy</label>
      </div>
      <div class="error-msg" id="termsError" style="margin-top: -14px; margin-bottom: 14px;">You must agree before registering.</div>

      <button type="submit" class="submit-btn">Register</button>
      <div class="status-banner" id="statusBanner"></div>
    </form>
  </div>

  <script>
    const form = document.getElementById("registerForm");
    const fullName = document.getElementById("fullName");
    const email = document.getElementById("email");
    const password = document.getElementById("password");
    const confirmPassword = document.getElementById("confirmPassword");
    const terms = document.getElementById("terms");
    const togglePassword = document.getElementById("togglePassword");
    const statusBanner = document.getElementById("statusBanner");

    // Toggle password visibility
    togglePassword.addEventListener("click", () => {
      const isPassword = password.type === "password";
      password.type = isPassword ? "text" : "password";
      togglePassword.textContent = isPassword ? "Hide" : "Show";
    });

    function showError(input, errorId, condition) {
      const errorEl = document.getElementById(errorId);
      if (condition) {
        errorEl.style.display = "block";
        if (input && input.type !== "checkbox") input.classList.add("error-border");
        return false;
      } else {
        errorEl.style.display = "none";
        if (input && input.type !== "checkbox") input.classList.remove("error-border");
        return true;
      }
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      statusBanner.className = "status-banner";
      statusBanner.textContent = "";

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      const isNameValid = showError(fullName, "nameError", fullName.value.trim().length < 2);
      const isEmailValid = showError(email, "emailError", !emailPattern.test(email.value.trim()));
      const isPassValid = showError(password, "passwordError", password.value.length < 8);
      const isConfirmValid = showError(
        confirmPassword,
        "confirmError",
        confirmPassword.value !== password.value || confirmPassword.value === ""
      );
      const isTermsValid = showError(terms, "termsError", !terms.checked);

      if (isNameValid && isEmailValid && isPassValid && isConfirmValid && isTermsValid) {
        statusBanner.textContent = `Welcome, ${fullName.value.trim()}! Your account has been created.`;
        statusBanner.classList.add("success");
        form.reset();
      }
    });
  </script>

</body>
</html>
